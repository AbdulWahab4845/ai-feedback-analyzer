style=\"padding:12px 0; font-size:13px; color:#8a8a8a;\">Neutral</td><td style=\"padding:12px 0; font-size:13px; color:#1a1a1a;\">{{ $json.neutral_count }}</td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:20px 24px 28px;\"><div style=\"font-size:13px; color:#8a8a8a; margin-bottom:6px;\">Note</div><div style=\"font-size:14px; color:#1a1a1a; line-height:1.6;\">{{ $json.repeat_section_html.replace(/<[^>]*>/g, '') }}</div></td></tr>\n<tr><td style=\"padding:16px 24px; border-top:1px solid #e5e5e5; background:#fafafa;\"><div style=\"font-size:12px; color:#9a9a9a; line-height:1.6;\">This report is generated automatically every 7 days. You're receiving this because you're an administrator of this feedback system.</div></td></tr>\n</table>\n</div>",
