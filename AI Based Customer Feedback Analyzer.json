      "parameters": {
        "jsCode": "const items = $input.all();\n\nfunction getField(json, name) {\n  const key = Object.keys(json).find(k => k.toLowerCase() === name.toLowerCase());\n  return key ? json[key] : undefined;\n}\nfunction cleanTs(item) {\n  return String(getField(item.json, 'timestamp') || '').trim();\n}\n\nlet mostRecent = new Date(0);\nfor (const item of items) {\n  const ts = new Date(cleanTs(item));\n  if (!isNaN(ts.getTime()) && ts > mostRecent) mostRecent = ts;\n}\n\nconst sevenDaysAgo = new Date(mostRecent.getTime() - 7 * 24 * 60 * 60 * 1000);\nconst recentItems = items.filter(item => {\n  const ts = new Date(cleanTs(item));\n  return !isNaN(ts.getTime()) && ts >= sevenDaysAgo;\n});\n\nconst total = recentItems.length;\nlet positive = 0, negative = 0, neutral = 0, totalScore = 0;\nconst emailCounts = {};\n\nfor (const item of recentItems) {\n  const sentiment = String(getField(item.json, 'sentiment') || '').toLowerCase().trim();\n  const score = parseFloat(getField(item.json, 'score')) || 0;\n  const email = String(getField(item.json, 'email') || 'unknown').trim();\n\n  totalScore += score;\n  if (sentiment === 'positive') positive++;\n  else if (sentiment === 'negative') negative++;\n  else neutral++;\n\n  emailCounts[email] = (emailCounts[email] || 0) + 1;\n}\n\nconst avgScore = total > 0 ? (totalScore / total).toFixed(2) : 0;\n\n// Sirf un emails ko list karein jinhone 1 se zyada feedback diya\nconst repeatSubmitters = Object.entries(emailCounts)\n  .filter(([email, count]) => count > 1)\n  .sort((a, b) => b[1] - a[1])\n  .map(([email, count]) => `<li>${email} — ${count} submissions</li>`)\n  .join('');\n\nconst repeatSection = repeatSubmitters\n  ? `<h3>Repeat Feedback (Same Email, Multiple Submissions)</h3><ul>${repeatSubmitters}</ul>`\n  : `<p><i>No repeat submissions this week — all feedback came from unique emails.</i></p>`;\n\nreturn [{\n  json: {\n    total_feedback: total,\n    positive_count: positive,\n    negative_count: negative,\n    neutral_count: neutral,\n    average_score: avgScore,\n    report_date: mostRecent.toISOString().split('T')[0],\n    period_start: sevenDaysAgo.toISOString().split('T')[0],\n    period_end: mostRecent.toISOString().split('T')[0],\n    repeat_section_html: repeatSection\n  }\n}];"
      },
