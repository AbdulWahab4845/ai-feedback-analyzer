        "mode": "runOnceForEachItem",
        "jsCode": "const input = $input.item.json;\nlet result = { sentiment: 'unknown', score: 0, summary: 'Sentiment analysis failed' };\ntry {\n  const raw = input.candidates[0].content.parts[0].text;\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n  result = {\n    sentiment: (parsed.sentiment || 'unknown').toLowerCase(),\n    score: typeof parsed.score === 'number' ? parsed.score : 0,\n    summary: parsed.summary || ''\n  };\n} catch (err) {\n  result.parse_error = err.message;\n}\nconst original = $('Valid Feedback?').item.json;\nreturn { json: { ...original, ...result } };"
